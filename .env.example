# Supabase Auth + database (required on Vercel for persistent orders)
# Leave unset locally to use in-memory seed data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only — used to read/write orders and auto-seed when tables are empty
SUPABASE_SERVICE_ROLE_KEY=
